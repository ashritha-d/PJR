# Database (swap to a Postgres/MySQL URL for real deployment — no other code changes needed)
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Not yet connected to a real provider. Wire these up when credentials exist ---

# Email (used for password-reset links). Until set, reset links are shown on-screen.
# EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
# EMAIL_FROM="PJR Farm & Agro Products <no-reply@pjrfarm.com>"

# Payment gateway (Razorpay/Stripe/UPI). Until set, online/UPI payments are simulated.
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""

# Cloud file storage (S3/Cloudinary). Until set, uploads are saved to /public/uploads.
# UPLOAD_DRIVER="local"
# CLOUD_STORAGE_BUCKET=""
